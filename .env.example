# =============================================================================
# Sistema de Trading MMXM + SMT — configuracao
#
# Copie para `.env` e preencha. NADA aqui e obrigatorio para arrancar:
# sem Supabase o motor corre e imprime na consola; sem Telegram/n8n nao notifica.
# A unica fonte de dados essencial (Yahoo) nao precisa de chave.
# =============================================================================

# -----------------------------------------------------------------------------
# MODO DE EXECUCAO
#
# 'paper' (por omissao) analisa, grava e notifica, mas NAO envia ordens.
# Qualquer valor que nao seja exatamente 'live' resolve para 'paper' — um erro
# de digitacao nunca se transforma em ordens reais.
#
# Nota: esta versao do sistema NAO tem adapter de execucao ligado a corretora.
# 'live' apenas marca os registos; nenhuma ordem e enviada em circunstancia
# alguma. A execucao continua a ser manual, por decisao de desenho.
# -----------------------------------------------------------------------------
EXECUTION_MODE=paper

# -----------------------------------------------------------------------------
# ESTRATEGIA
# -----------------------------------------------------------------------------
# Timeframe onde os sinais sao procurados: 1d (swing de semanas) ou 1w (posicao).
TIMEFRAME=1d
# Timeframe da narrativa institucional.
HIGHER_TIMEFRAME=1w
# Historico carregado por instrumento.
CANDLE_LIMIT=400
HIGHER_CANDLE_LIMIT=200
# R minimo para um setup ser emitido. Abaixo de 3 a cauda de 5-10R desaparece.
MIN_R_MULTIPLE=3
# Confianca minima do sinal.
#
# Mede APENAS o que varia entre sinais que ja passaram o checklist: a forca do
# modelo MMXM (60%) e a qualidade do padrao de entrada (40%). O checklist nao
# entra na formula — e um portao binario, nao uma nota.
#
# Historico: ate a correcao, o checklist entrava com peso 0,5 e, como os seus
# pesos somam 1,0 e o sinal so chega aqui se ele passar, isso era uma constante.
# Uma analise de sensibilidade com 0,40 / 0,50 / 0,60 / 0,70 devolveu resultados
# IDENTICOS nas quatro — o parametro nao estava ligado a nada.
MIN_CONFIDENCE=0.6
# Vazio = universo completo. Ex.: SYMBOLS=EURUSD,NQ,XAUUSD,BTCUSD
SYMBOLS=

# -----------------------------------------------------------------------------
# RISCO
#
# LEIA ISTO. "Entrar com 100 e sair com 500" so fecha se os 100 forem o valor
# EM RISCO, nao a margem. Isso significa arriscar 100% do capital numa operacao.
# O intervalo institucional e 0,5% a 2%. A 1% com alvos de 5R, o break-even
# fica em ~17% de acerto — mas so sobrevive quem aguenta a sequencia de perdas.
# -----------------------------------------------------------------------------
ACCOUNT_BALANCE=1000
RISK_PERCENT_PER_TRADE=1
MAX_PORTFOLIO_RISK_PERCENT=5
MAX_CONCURRENT_POSITIONS=5

# -----------------------------------------------------------------------------
# AGENDAMENTO
#
# 22:15 UTC de segunda a sexta: depois do fecho de Nova Iorque, para que a vela
# diaria ja esteja FECHADA. Analisar antes seria decidir sobre vela em formacao.
# -----------------------------------------------------------------------------
SCAN_CRON=15 22 * * 1-5

# -----------------------------------------------------------------------------
# SUPABASE
#
# A SERVICE_ROLE key ignora RLS e so pode viver no servidor (motor). O dashboard
# usa a ANON key, que por politica RLS so tem leitura.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Usadas pelo dashboard (expostas ao browser — nunca ponha a service_role aqui):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Gravar velas na base de dados (volumoso; util para backtest reproduzivel).
PERSIST_CANDLES=false

# -----------------------------------------------------------------------------
# TELEGRAM
#
# 1. Fale com @BotFather -> /newbot -> copie o token.
# 2. Envie uma mensagem ao seu bot.
# 3. Abra https://api.telegram.org/bot<TOKEN>/getUpdates e copie o chat.id.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# N8N
#
# Crie um workflow com um no "Webhook" (POST) e cole aqui o Production URL.
# O motor envia os eventos: signal.entry, signal.exit, scan.completed,
# system.error. O segredo, se definido, viaja no header X-Webhook-Secret —
# valide-o no n8n para que ninguem mais consiga disparar o seu workflow.
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Public API do n8n (NAO usada pelo motor) --------------------------------
# Serve apenas ao `npm run setup:n8n`, que cria o workflow de webhook
# automaticamente. Sao coisas DIFERENTES:
#   N8N_WEBHOOK_URL - endereco que RECEBE os eventos do motor (runtime)
#   N8N_API_KEY     - credencial para GERIR workflows no n8n (so no setup)
N8N_BASE_URL=
N8N_API_KEY=

# -----------------------------------------------------------------------------
# FONTES DE DADOS OPCIONAIS
#
# O sistema funciona SEM nenhuma destas. Servem de redundancia: o registry faz
# failover automatico por ordem de prioridade quando o Yahoo falha.
# O catalogo completo das 176 APIs publicas de financas esta em
# packages/data/src/catalog.ts — estas sao apenas as que tem adapter escrito.
# -----------------------------------------------------------------------------
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# -----------------------------------------------------------------------------
# BACKTEST
# -----------------------------------------------------------------------------
BACKTEST_CANDLES=1500

# -----------------------------------------------------------------------------
# LOGIN E CONTA DERIV  (painel: apps/dashboard/.env.local)
#
# Cada utilizador liga a SUA conta Deriv com OAuth, na pagina de login da propria
# Deriv. O token do servidor (DERIV_TOKEN) so responde a quem tiver o email em
# DERIV_DONO_EMAIL — em producao, nunca a visitantes sem login.
# -----------------------------------------------------------------------------
DERIV_APP_ID=
# Token do dono (API nova, pat_...). Opcional se toda a gente usar OAuth.
DERIV_TOKEN=
DERIV_DONO_EMAIL=
# Tem de estar registado EXATAMENTE assim na aplicacao Deriv (https, sem barra final).
DERIV_OAUTH_REDIRECT=https://trivohub.io/api/deriv/oauth/retorno
# Ambitos pedidos a Deriv. Omissao: trade account_manage
DERIV_OAUTH_SCOPE=
# Cifra os cookies da ligacao Deriv. 32+ caracteres aleatorios. Troca-la desliga todos.
COFRE_CHAVE=
# Em desenvolvimento, exigir login como em producao (true/false)
DERIV_EXIGIR_LOGIN=

# -----------------------------------------------------------------------------
# MOTOR <-> PAINEL
# -----------------------------------------------------------------------------
# Segredo partilhado para o motor pedir envios push ao painel. IGUAL nos dois .env.
MOTOR_SEGREDO=
# Vazio em producao: o motor usa a porta de PORT. So para desenvolvimento local.
DASHBOARD_URL=
# Contas cujos movimentos o motor anuncia (todas | demo | real | nenhuma)
DERIV_OUVIR_CONTAS=todas
