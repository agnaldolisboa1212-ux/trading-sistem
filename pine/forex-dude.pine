// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Agnaldo Lisboa — trading-sistem
//
// FOREX DUDE — todas as estratégias do trading-sistem num só indicador.
//
//   ICT ALGO                       setup 1H + tiro no gráfico     (secção abaixo)
//   Asia Range                     POI 15M + MSS no gráfico        (secção abaixo)
//   Compra no VWAP (−2σ)           1H e 4H   validadas.ts · planCompraVwapIndices
//   Venda no VWAP (+2σ)            1H e 4H   em-teste.ts  · planVendaVwapIndices
//   RSI(2) de Connors              1D        validadas.ts · planConnorsIndices
//   Tendência 55 dias (compra)     1D        validadas.ts · planTendencia55d (cripto, ouro, Nikkei)
//   Tendência de baixa 55 dias     1D        em-teste.ts  · planTendenciaBaixaCripto
//   Rompimento de 20 velas         4H        validadas.ts · planRompimento4h
//   Abertura de Londres no DAX     30M       em-teste.ts  · planAberturaDaxTeste
//
// CADA ESTRATÉGIA tem nas definições:
//   · "Ligar"  — liga/desliga a estratégia
//   · "Pares"  — em que pares corre, separados por vírgulas (o ticker do
//                TradingView: EURUSD, XAUUSD, US30, NAS100…). "*" = todos.
//                O indicador vê o par do gráfico: se não estiver na lista, a
//                estratégia fica desligada nesse gráfico.
// Cada uma corre no SEU timeframe (request.security, só velas fechadas), seja
// qual for o do gráfico; o ICT ALGO e o Asia Range querem um gráfico de 1M a 5M
// para o gatilho. Alertas: um por estratégia (alertcondition) e um geral com
// entrada, stop e alvo ("Any alert() function call"), mais "Qualquer estratégia".
// Use um gráfico de timeframe igual ou menor do que o da estratégia (num gráfico
// diário, as de 1H/4H/30M não aparecem vela a vela). O painel mostra, para o par
// do gráfico, cada estratégia ligada / desligada / fora deste par e o último sinal.
//
// ── ASIA RANGE (o setup do journal, packages/core/src/ict/poi-sessao.ts) ──────
//   Estrutura  o viés é o lado da última quebra de estrutura de 15M até às 08:00
//              de Londres
//   POI        topos e fundos de 15M (8 velas de cada lado) dos últimos 3 dias,
//              ainda por tocar às 08:00, do lado do viés (venda: acima do preço;
//              compra: abaixo). Zona: topo → [max(abertura, fecho), máximo];
//              fundo → [mínimo, min(abertura, fecho)]
//   Ásia       00:00–08:00 de Londres (a caixa)
//   Janela     08:00–11:00 de Londres
//   Toque      o preço entra num POI; passar o POI em mais de ½ ATR(15M) anula-o
//   MSS        o primeiro fecho no gráfico além do último swing do lado oposto
//              (2 velas de cada lado) — é o sinal, no fecho dessa vela
//   Stop       além do POI (o mais afastado entre a borda da zona e o extremo
//              feito), pelo menos ¼ ATR(15M)
//   Alvo       a liquidez oposta por tomar (extremo oposto da Ásia, mínimo/máximo
//              de ontem, POI do lado oposto) — a mais próxima que pague 2R
//   SMT        confluência (opcional): o par correlacionado andou ao contrário
//              desde as 08:00
//   Um tiro por dia.
//
// ── ICT ALGO (setup fixo de 1H + tiro, packages/core/src/ict/gatilho.ts) ──────
//   Viés       estrutura diária (a última quebra de swing diário)
//   Setup 1H   varrimento de liquidez contra o viés (pavio além de um swing de 1H
//              e fecho de volta), MSS com deslocamento (corpo ≥ 1 ATR) e FVG
//              deixado pelo deslocamento → zona = o FVG inteiro
//   Stop       para lá do POI: além do extremo varrido e da zona, + 0,1 ATR(1H)
//              ("os stops devem ser abaixo da POI; a sniper entry só confirma")
//   Alvo       a liquidez do outro lado (máximo/mínimo das últimas N velas de 1H);
//              se o preço o tomar antes de vir à zona, o alvo passa ao novo extremo
//   Tiro       nas killzones (Londres 02–05h, NY 07–10h, hora de Nova Iorque): o
//              preço entra na zona e o gráfico faz CHoCH a favor → entrada no
//              fecho; stop o do setup; RR ≥ 2
//   Fica fixo até disparar, ser invalidado (stop tocado antes) ou 24 h.
//
// Sem vantagem estatística provada (ver os backtests do repositório): alertas,
// não ordens. A decisão é de quem opera.

//@version=5
indicator("Forex dude", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═══ Entradas ══════════════════════════════════════════════════════════════
grpA = "Asia Range"
usarAsia   = input.bool(true, "Ligar Asia Range", group = grpA)
paresAsia  = input.string("GBPJPY,USDJPY,EURJPY,USDCAD,GBPUSD,EURUSD", "Pares", group = grpA)
poiLen     = input.int(8, "Swing dos POI (velas de 15M de cada lado)", minval = 2, group = grpA)
estLen     = input.int(3, "Swing da estrutura de 15M", minval = 1, group = grpA)
diasPoi    = input.int(3, "Dias de POI", minval = 1, maxval = 10, group = grpA)
smtSym     = input.symbol("", "Par para SMT (opcional, ex.: GBPUSD para o EURUSD)", group = grpA)
mostrarPoi = input.bool(true, "Desenhar os POI activos", group = grpA)

grpI = "ICT ALGO"
usarIct    = input.bool(true, "Ligar ICT ALGO", group = grpI)
paresIct   = input.string("EURUSD,GBPUSD,USDJPY,EURJPY,GBPJPY,XAUUSD,GOLD,US100,NAS100,NDX,SP500,US500,SPX,US30,DJI,GER30,GER40,DE40", "Pares", group = grpI)
ictLen     = input.int(3, "Swing de 1H", minval = 1, group = grpI)
dispMin    = input.float(1.0, "Deslocamento mínimo do MSS (× ATR 1H)", minval = 0.1, step = 0.1, group = grpI)
janelaMss  = input.int(10, "Velas de 1H entre varrimento e MSS", minval = 1, group = grpI)
liqLook    = input.int(60, "Velas de 1H para a liquidez (alvo)", minval = 10, group = grpI)
filtroVies = input.bool(true, "Só a favor do viés diário", group = grpI)
soKz       = input.bool(true, "Tiro só nas killzones", group = grpI)

IDX = "US100,NAS100,NDX,SP500,US500,SPX,US30,DJI,GER30,GER40,DE40,DAX"
grpVc = "Compra no VWAP (−2σ) · 1H/4H"
usarVc   = input.bool(true, "Ligar", group = grpVc)
paresVc  = input.string(IDX + ",GBPUSD", "Pares", group = grpVc)
vc1h     = input.bool(true, "Em 1H", inline = "vc", group = grpVc)
vc4h     = input.bool(true, "Em 4H", inline = "vc", group = grpVc)
grpVv = "Venda no VWAP (+2σ) · 1H/4H"
usarVv   = input.bool(true, "Ligar", group = grpVv)
paresVv  = input.string(IDX + ",GBPUSD,EURUSD,USDCAD,USDJPY,XAUUSD,GOLD", "Pares", group = grpVv)
vv1h     = input.bool(true, "Em 1H", inline = "vv", group = grpVv)
vv4h     = input.bool(true, "Em 4H", inline = "vv", group = grpVv)
grpCo = "RSI(2) de Connors · 1D"
usarCo   = input.bool(true, "Ligar", group = grpCo)
paresCo  = input.string(IDX + ",JP225,NI225,JPN225,BTCUSD,XPDUSD", "Pares", group = grpCo)
grpTe = "Tendência 55 dias (compra) · 1D"
usarTe   = input.bool(true, "Ligar", group = grpTe)
paresTe  = input.string("BTCUSD,ETHUSD,XAUUSD,GOLD,JP225,NI225,JPN225", "Pares", group = grpTe)
grpTb = "Tendência de baixa 55 dias · 1D"
usarTb   = input.bool(true, "Ligar", group = grpTb)
paresTb  = input.string("BTCUSD,ETHUSD", "Pares", group = grpTb)
grpRo = "Rompimento de 20 velas · 4H"
usarRo   = input.bool(true, "Ligar", group = grpRo)
paresRo  = input.string("XAUUSD,GOLD,USDJPY,XAGUSD,SILVER,EURJPY", "Pares", group = grpRo)
grpDx = "Abertura de Londres no DAX · 30M"
usarDx   = input.bool(true, "Ligar", group = grpDx)
paresDx  = input.string("GER30,GER40,DE40,DAX", "Pares", group = grpDx)
custoDx  = input.float(2.5, "Risco mínimo (pontos)", minval = 0, group = grpDx)

grpG = "Gatilho e geral"
gatLen   = input.int(2, "Swing do gatilho (velas do gráfico)", minval = 1, group = grpG)
rrMin    = input.float(2.0, "RR mínimo", minval = 1.0, step = 0.5, group = grpG)
corCompra = input.color(color.new(#22c55e, 0), "Compra", group = grpG)
corVenda  = input.color(color.new(#ef4444, 0), "Venda", group = grpG)

TZL = "Europe/London"
TZN = "America/New_York"

// ═══ Utilitários ═══════════════════════════════════════════════════════════
emSessao(sess, tz) => not na(time(timeframe.period, sess, tz))

// A estratégia corre neste par? (lista separada por vírgulas; "*" = todos)
noPar(string lista) =>
    l = str.upper(str.replace_all(lista, " ", ""))
    l == "*" or str.contains("," + l + ",", "," + str.upper(syminfo.ticker) + ",")

asiaOn = usarAsia and noPar(paresAsia)
ictOn  = usarIct and noPar(paresIct)

// Último sinal de cada estratégia (para o painel)
var string[] ultimo = array.new_string(9, "—")
quando(int dir) => (dir == 1 ? "compra " : "venda ") + str.format_time(time, "dd/MM HH:mm", syminfo.timezone)

desenharPlano(int dir, float entrada, float stop, float alvo, string nome) =>
    c = dir == 1 ? corCompra : corVenda
    t2 = time + 12 * 3600000
    line.new(time, entrada, t2, entrada, xloc = xloc.bar_time, color = color.new(color.white, 0), width = 1)
    line.new(time, stop, t2, stop, xloc = xloc.bar_time, color = corVenda, style = line.style_dashed)
    if not na(alvo)
        line.new(time, alvo, t2, alvo, xloc = xloc.bar_time, color = corCompra, style = line.style_dashed)
    rr = na(alvo) ? na : math.abs(alvo - entrada) / math.abs(entrada - stop)
    tp = na(alvo) ? "sem alvo fixo" : str.tostring(alvo, format.mintick) + " (" + str.tostring(rr, "#.0") + "R)"
    txt = nome + (dir == 1 ? " COMPRA" : " VENDA") + "\nENT " + str.tostring(entrada, format.mintick) + "\nSL " + str.tostring(stop, format.mintick) + "\nTP " + tp
    label.new(bar_index, dir == 1 ? low : high, txt, color = c, textcolor = color.white, style = dir == 1 ? label.style_label_up : label.style_label_down, size = size.small)

// Swing do gráfico (gatilho / MSS)
var float swH = na
var float swL = na
var int swHt = na
var int swLt = na
gph = ta.pivothigh(high, gatLen, gatLen)
gpl = ta.pivotlow(low, gatLen, gatLen)
if not na(gph)
    swH := gph
    swHt := time[gatLen]
if not na(gpl)
    swL := gpl
    swLt := time[gatLen]

// ═══ 15M: POI, estrutura, ATR ══════════════════════════════════════════════
f15() =>
    ph = ta.pivothigh(high, poiLen, poiLen)
    pl = ta.pivotlow(low, poiLen, poiLen)
    sh = ta.pivothigh(high, estLen, estLen)
    sl = ta.pivotlow(low, estLen, estLen)
    var float lastH = na
    var float lastL = na
    var int vies = 0
    if not na(sh)
        lastH := sh
    if not na(sl)
        lastL := sl
    if not na(lastH) and close > lastH
        vies := 1
        lastH := na
    if not na(lastL) and close < lastL
        vies := -1
        lastL := na
    [ph[1], high[poiLen + 1], math.max(open[poiLen + 1], close[poiLen + 1]), time[poiLen + 1], pl[1], math.min(open[poiLen + 1], close[poiLen + 1]), low[poiLen + 1], time[poiLen + 1], vies[1], ta.atr(14)[1]]

[ph15, phTop, phBot, phT, pl15, plTop, plBot, plT, vies15, atr15] = request.security(syminfo.tickerid, "15", f15(), lookahead = barmerge.lookahead_on)

// Ontem (liquidez)
[ontemH, ontemL] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// POI guardados
var float[] pTop = array.new_float()
var float[] pBot = array.new_float()
var int[] pT = array.new_int()
var int[] pLado = array.new_int()     // 1 = topo (POI de venda), -1 = fundo (POI de compra)
var bool[] pTocado = array.new_bool()

novoPh = not na(ph15) and (phT != phT[1] or na(ph15[1]))
novoPl = not na(pl15) and (plT != plT[1] or na(pl15[1]))
if asiaOn and novoPh
    array.push(pTop, phTop)
    array.push(pBot, phBot)
    array.push(pT, phT)
    array.push(pLado, 1)
    array.push(pTocado, false)
if asiaOn and novoPl
    array.push(pTop, plTop)
    array.push(pBot, plBot)
    array.push(pT, plT)
    array.push(pLado, -1)
    array.push(pTocado, false)

// Apagar os mais antigos do que os dias de POI (+1 de folga)
while array.size(pT) > 0
    if time - array.get(pT, 0) > (diasPoi + 1) * 86400000
        array.shift(pTop)
        array.shift(pBot)
        array.shift(pT)
        array.shift(pLado)
        array.shift(pTocado)
    else
        break

// ═══ Sessões de Londres ═════════════════════════════════════════════════════
naAsia   = emSessao("0000-0800", TZL)
naJanela = emSessao("0800-1100", TZL)
novoDia  = dayofmonth(time, TZL) != dayofmonth(time[1], TZL)

var float asiaH = na
var float asiaL = na
var int asiaT0 = na
var box caixaAsia = na
if novoDia
    asiaH := na
    asiaL := na
    asiaT0 := time
if naAsia
    asiaH := na(asiaH) ? high : math.max(asiaH, high)
    asiaL := na(asiaL) ? low : math.min(asiaL, low)
    if asiaOn
        if na(caixaAsia) or novoDia
            caixaAsia := box.new(asiaT0, asiaH, time, asiaL, xloc = xloc.bar_time, bgcolor = color.new(color.blue, 90), border_color = color.new(color.blue, 60), text = "Ásia", text_color = color.new(color.blue, 30), text_size = size.small)
        else
            box.set_top(caixaAsia, asiaH)
            box.set_bottom(caixaAsia, asiaL)
            box.set_right(caixaAsia, time)

// SMT: o par desde as 08:00
[parC, parO] = request.security(smtSym == "" ? syminfo.tickerid : smtSym, timeframe.period, [close, open], lookahead = barmerge.lookahead_off)

// ═══ Asia Range: estado do dia ══════════════════════════════════════════════
var int diaVies = 0
var bool diaFeito = false
var int poiIdx = -1         // 1 = há um POI tocado em seguimento
var float selTop = na
var float selBot = na
var float poiExt = na       // extremo feito no POI
var int poiExtT = na
var float ab08 = na
var float parAb08 = na
var box[] caixasPoi = array.new_box()
var float maxDesde = na
var float minDesde = na

inicioJanela = naJanela and not naJanela[1]
if novoDia
    diaFeito := false
    poiIdx := -1
    poiExt := na

if asiaOn and inicioJanela
    diaVies := vies15
    ab08 := open
    parAb08 := parO
    maxDesde := high
    minDesde := low
    // Os POI do dia: por tocar, do lado do viés, dentro dos dias de POI
    while array.size(caixasPoi) > 0
        box.delete(array.pop(caixasPoi))
    if mostrarPoi and array.size(pT) > 0
        for i = 0 to array.size(pT) - 1
            ladoOk = (diaVies == -1 and array.get(pLado, i) == 1 and array.get(pBot, i) > close) or (diaVies == 1 and array.get(pLado, i) == -1 and array.get(pTop, i) < close)
            if ladoOk and not array.get(pTocado, i) and time - array.get(pT, i) <= diasPoi * 86400000
                array.push(caixasPoi, box.new(array.get(pT, i), array.get(pTop, i), time + 3 * 3600000, array.get(pBot, i), xloc = xloc.bar_time, bgcolor = color.new(color.purple, 85), border_color = color.new(color.purple, 50), text = "POI", text_color = color.new(color.purple, 20), text_size = size.tiny))

if naJanela
    maxDesde := na(maxDesde) ? high : math.max(maxDesde, high)
    minDesde := na(minDesde) ? low : math.min(minDesde, low)

sinalAsia = 0
float aEnt = na
float aStop = na
float aAlvo = na

if asiaOn and naJanela and not diaFeito and diaVies != 0 and array.size(pT) > 0
    venda = diaVies == -1
    // 1 — o toque: o primeiro POI do dia em que o preço entra
    if poiIdx < 0
        for i = 0 to array.size(pT) - 1
            ladoOk = venda ? array.get(pLado, i) == 1 : array.get(pLado, i) == -1
            if ladoOk and not array.get(pTocado, i) and time - array.get(pT, i) <= diasPoi * 86400000
                tocou = venda ? high >= array.get(pBot, i) : low <= array.get(pTop, i)
                if tocou and poiIdx < 0
                    poiIdx := 1
                    selTop := array.get(pTop, i)
                    selBot := array.get(pBot, i)
                    poiExt := venda ? high : low
                    poiExtT := time
    // 2 — o extremo, a anulação e o MSS
    if poiIdx >= 0
        borda = venda ? selTop : selBot
        if venda ? high > poiExt : low < poiExt
            poiExt := venda ? high : low
            poiExtT := time
        if venda ? poiExt > borda + 0.5 * atr15 : poiExt < borda - 0.5 * atr15
            poiIdx := -1           // passou o POI: deixa de valer
        else
            nivel = venda ? swL : swH
            nivelT = venda ? swLt : swHt
            mss = not na(nivel) and nivelT < poiExtT and time > poiExtT and (venda ? close < nivel : close > nivel)
            if mss
                ent = close
                stp = venda ? math.max(borda, poiExt) : math.min(borda, poiExt)
                stp := venda ? math.max(stp, ent + 0.25 * atr15) : math.min(stp, ent - 0.25 * atr15)
                risco = math.abs(ent - stp)
                // Alvo: a liquidez oposta por tomar, a mais próxima que pague o RR mínimo
                float melhor = na
                cands = array.from(venda ? asiaL : asiaH, venda ? ontemL : ontemH)
                for j = 0 to array.size(pT) - 1
                    if array.get(pLado, j) == (venda ? -1 : 1) and not array.get(pTocado, j)
                        array.push(cands, venda ? array.get(pBot, j) : array.get(pTop, j))
                for c in cands
                    porTomar = not na(c) and (venda ? c < minDesde and c < ent : c > maxDesde and c > ent)
                    if porTomar and math.abs(ent - c) >= rrMin * risco
                        if na(melhor) or (venda ? c > melhor : c < melhor)
                            melhor := c
                if not na(melhor)
                    sinalAsia := venda ? -1 : 1
                    aEnt := ent
                    aStop := stp
                    aAlvo := melhor
                    diaFeito := true

// Marcar POI tocados (depois da avaliação desta vela)
if array.size(pT) > 0
    for i = 0 to array.size(pT) - 1
        if not array.get(pTocado, i) and time > array.get(pT, i) + 900000 * (poiLen + 1)
            if array.get(pLado, i) == 1 ? high >= array.get(pBot, i) : low <= array.get(pTop, i)
                array.set(pTocado, i, true)

smtAsia = smtSym != "" and not na(parAb08) and math.sign(close - ab08) != 0 and math.sign(parC - parAb08) == -math.sign(close - ab08)
if sinalAsia != 0
    desenharPlano(sinalAsia, aEnt, aStop, aAlvo, "ASIA" + (smtAsia ? " +SMT" : ""))
    array.set(ultimo, 0, quando(sinalAsia))
    alert("Forex dude · Asia Range " + (sinalAsia == 1 ? "COMPRA " : "VENDA ") + syminfo.ticker + " ENT " + str.tostring(aEnt, format.mintick) + " SL " + str.tostring(aStop, format.mintick) + " TP " + str.tostring(aAlvo, format.mintick), alert.freq_once_per_bar_close)

// ═══ ICT ALGO: viés diário e setup de 1H ════════════════════════════════════
fD() =>
    sh = ta.pivothigh(high, 2, 2)
    sl = ta.pivotlow(low, 2, 2)
    var float lh = na
    var float ll = na
    var int v = 0
    if not na(sh)
        lh := sh
    if not na(sl)
        ll := sl
    if not na(lh) and close > lh
        v := 1
        lh := na
    if not na(ll) and close < ll
        v := -1
        ll := na
    v[1]

viesD = request.security(syminfo.tickerid, "D", fD(), lookahead = barmerge.lookahead_on)

f1h() =>
    a = ta.atr(14)
    hiLiq = ta.highest(high, liqLook)
    loLiq = ta.lowest(low, liqLook)
    sh = ta.pivothigh(high, ictLen, ictLen)
    sl = ta.pivotlow(low, ictLen, ictLen)
    var float lastH = na
    var float lastL = na
    if not na(sh)
        lastH := sh
    if not na(sl)
        lastL := sl
    // Varrimentos: pavio além do swing e fecho de volta
    var float varAlta = na     // extremo varrido para uma compra (sell-side)
    var int varAltaBar = na
    var float varBaixa = na
    var int varBaixaBar = na
    if not na(lastL) and low < lastL and close > lastL
        varAlta := na(varAlta) or bar_index - varAltaBar > janelaMss ? low : math.min(varAlta, low)
        varAltaBar := bar_index
    if not na(lastH) and high > lastH and close < lastH
        varBaixa := na(varBaixa) or bar_index - varBaixaBar > janelaMss ? high : math.max(varBaixa, high)
        varBaixaBar := bar_index
    // MSS com deslocamento e o FVG que deixa (velas [2] e [0] sem sobreposição)
    var int sDir = 0
    var float sTop = na
    var float sBot = na
    var float sStop = na
    var float sAlvo = na
    var int sT = na
    mssAlta = not na(varAlta) and bar_index - varAltaBar <= janelaMss and not na(lastH) and close > lastH and close - open >= dispMin * a
    mssBaixa = not na(varBaixa) and bar_index - varBaixaBar <= janelaMss and not na(lastL) and close < lastL and open - close >= dispMin * a
    fvgAlta = low > high[2]
    fvgBaixa = high < low[2]
    if mssAlta and fvgAlta
        topo = low
        fundo = high[2]
        stp = math.min(varAlta, fundo) - 0.1 * a
        alvo = hiLiq
        if alvo - topo >= rrMin * (topo - stp)
            sDir := 1
            sTop := topo
            sBot := fundo
            sStop := stp
            sAlvo := alvo
            sT := time
        varAlta := na
        lastH := na
    if mssBaixa and fvgBaixa
        fundo = high
        topo = low[2]
        stp = math.max(varBaixa, topo) + 0.1 * a
        alvo = loLiq
        if fundo - alvo >= rrMin * (stp - fundo)
            sDir := -1
            sTop := topo
            sBot := fundo
            sStop := stp
            sAlvo := alvo
            sT := time
        varBaixa := na
        lastL := na
    [sDir[1], sTop[1], sBot[1], sStop[1], sAlvo[1], sT[1]]

[hDir, hTop, hBot, hStop, hAlvo, hT] = request.security(syminfo.tickerid, "60", f1h(), lookahead = barmerge.lookahead_on)

// Estado do setup fixo
var int iDir = 0
var float iTop = na
var float iBot = na
var float iStop = na
var float iAlvo = na
var int iDesde = na
var int iTocado = na
var box iCaixa = na

if ictOn and not na(hT) and hT != nz(hT[1]) and hDir != 0 and (not filtroVies or hDir == viesD)
    iDir := hDir
    iTop := hTop
    iBot := hBot
    iStop := hStop
    iAlvo := hAlvo
    iDesde := time
    iTocado := na
    iCaixa := box.new(hT, iTop, hT + 24 * 3600000, iBot, xloc = xloc.bar_time, bgcolor = color.new(iDir == 1 ? corCompra : corVenda, 85), border_color = color.new(iDir == 1 ? corCompra : corVenda, 40), text = "ICT 1H", text_color = color.new(color.white, 30), text_size = size.tiny)

kz = emSessao("0200-0500", TZN) or emSessao("0700-1000", TZN)
sinalIct = 0
float iEnt = na

if ictOn and iDir != 0
    compra = iDir == 1
    if time - iDesde > 24 * 3600000
        iDir := 0                                           // expirou
    else if compra ? low <= iStop : high >= iStop
        iDir := 0                                           // stop tocado antes do tiro: invalidado
    else
        // Alvo móvel: tomado antes da zona → o novo extremo
        if na(iTocado) and (compra ? high > iAlvo : low < iAlvo)
            iAlvo := compra ? high : low
        if na(iTocado) and (compra ? low <= iTop : high >= iBot)
            iTocado := time
        if not na(iTocado) and (not soKz or kz)
            nivel = compra ? swH : swL
            nivelT = compra ? swHt : swLt
            choch = not na(nivel) and (compra ? close > nivel : close < nivel) and (compra ? close[1] <= nivel : close[1] >= nivel)
            if choch
                ent = close
                if math.abs(iAlvo - ent) >= rrMin * math.abs(ent - iStop) and (compra ? iAlvo > ent and iStop < ent : iAlvo < ent and iStop > ent)
                    sinalIct := iDir
                    iEnt := ent
                    desenharPlano(iDir, ent, iStop, iAlvo, "ICT")
                    array.set(ultimo, 1, quando(iDir))
                    alert("Forex dude · ICT ALGO " + (compra ? "COMPRA " : "VENDA ") + syminfo.ticker + " ENT " + str.tostring(ent, format.mintick) + " SL " + str.tostring(iStop, format.mintick) + " TP " + str.tostring(iAlvo, format.mintick), alert.freq_once_per_bar_close)
                    iDir := 0

// ═══ As outras estratégias (cada uma no seu timeframe, só velas fechadas) ════
vcOn = usarVc and noPar(paresVc)
vvOn = usarVv and noPar(paresVv)
coOn = usarCo and noPar(paresCo)
teOn = usarTe and noPar(paresTe)
tbOn = usarTb and noPar(paresTb)
roOn = usarRo and noPar(paresRo)
dxOn = usarDx and noPar(paresDx)

// Diário: Connors, tendências de 55 dias, média de 200 e EMA 20 (até ontem)
fDia() =>
    s200 = ta.sma(close, 200)
    s5 = ta.sma(close, 5)
    r2 = ta.rsi(close, 2)
    a = ta.atr(14)
    mx55 = ta.highest(high, 55)
    mn55 = ta.lowest(low, 55)
    e20 = ta.ema(close, 20)
    // Connors: acima da média de 200 e RSI(2) < 10; alvo a média de 5 se estiver acima
    co = close > s200 and r2 < 10 and a > 0
    coAlvo = s5 > close ? s5 : na
    // Tendência 55d: o PRIMEIRO fecho acima do máximo dos 55 dias anteriores
    te = close > mx55[1] and not (close[1] > mx55[2]) and a > 0
    // Tendência de baixa: o primeiro fecho abaixo do mínimo de 55 dias, abaixo da média de 200
    tb = close < s200 and close < mn55[1] and not (close[1] < mn55[2]) and a > 0
    [co[1], close[1] - 2 * a[1], coAlvo[1], te[1], close[1] + 2 * a[1], tb[1], close[1], time[1], close[1] > s200[1], close[1] < s200[1], e20[1]]

[dCo, dStopC, dAlvoCo, dTe, dStopV, dTb, dEnt, dT, acima200, abaixo200, ema20D] = request.security(syminfo.tickerid, "D", fDia(), lookahead = barmerge.lookahead_on)

// VWAP do mês (TWAP do hlc3, como no motor: a Deriv não tem volume), bandas ±σ
fVwap() =>
    var float sw = 0.0
    var float swp = 0.0
    var float swp2 = 0.0
    var int n = 0
    if month(time, "UTC") != month(time[1], "UTC")
        sw := 0.0
        swp := 0.0
        swp2 := 0.0
        n := 0
    sw += 1.0
    swp += hlc3
    swp2 += hlc3 * hlc3
    n += 1
    vw = swp / sw
    vr = swp2 / sw - vw * vw
    sg = vr > 0 ? math.sqrt(vr) : 0.0
    z = sg > 0 ? (close - vw) / sg : 0.0
    a = ta.atr(14)
    r = ta.rsi(close, 14)
    ok = n >= 15 and sg > 0 and a > 0
    // Compra: fecho a −2σ ou menos, RSI(14) < 30 ou σ > 2 ATR (sem o filtro da vela desde 02/10/2026)
    cp = ok and z <= -2 and (r < 30 or sg > 2 * a)
    // Venda: fecho a +2σ ou mais, RSI(14) > 70 ou σ > 2 ATR
    vd = ok and z >= 2 and (r > 70 or sg > 2 * a)
    cStop = vw - (math.abs(z) + 1) * sg
    vStop = vw + (math.abs(z) + 1) * sg
    [cp[1], vd[1], close[1], cStop[1], vStop[1], time[1]]

[v1C, v1V, v1E, v1SC, v1SV, v1T] = request.security(syminfo.tickerid, "60", fVwap(), lookahead = barmerge.lookahead_on)
[v4C, v4V, v4E, v4SC, v4SV, v4T] = request.security(syminfo.tickerid, "240", fVwap(), lookahead = barmerge.lookahead_on)

// Rompimento de 20 velas em 4H: EMA 50 > EMA 200, fecho acima do máximo das 20
// anteriores, sem outro rompimento nas 6 velas antes; stop 1,5 ATR, alvo +3R
fRo() =>
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    mx = ta.highest(high, 20)
    a = ta.atr(14)
    disp = e50 > e200 and close > mx[1]
    antes = math.sum(disp ? 1 : 0, 6)[1]
    s = disp and nz(antes) == 0 and a > 0
    [s[1], close[1], close[1] - 1.5 * a[1], close[1] + 4.5 * a[1], time[1]]

[rS, rE, rStop, rAlvo, rT] = request.security(syminfo.tickerid, "240", fRo(), lookahead = barmerge.lookahead_on)

// DAX: 1.ª vela de 30M das 09:00 de Berlim; o primeiro fecho fora dela entre
// as 09:30 e as 12:00; stop no meio da faixa; risco maior do que o custo
fDx() =>
    tz = "Europe/Berlin"
    hh = hour(time, tz)
    mm = minute(time, tz)
    var float fHi = na
    var float fLo = na
    var bool feito = false
    if dayofmonth(time, tz) != dayofmonth(time[1], tz)
        fHi := na
        fLo := na
        feito := false
    if hh == 9 and mm == 0
        fHi := high
        fLo := low
        feito := false
    mins = hh * 60 + mm
    lado = 0
    if not na(fHi) and not feito and mins >= 570 and mins < 720 and fHi > fLo
        lado := close > fHi ? 1 : close < fLo ? -1 : 0
        if lado != 0
            feito := true
    meio = (fHi + fLo) / 2
    s = lado != 0 and (close - meio) * lado > custoDx ? lado : 0
    [s[1], close[1], meio[1], time[1]]

[xS, xE, xStop, xT] = request.security(syminfo.tickerid, "30", fDx(), lookahead = barmerge.lookahead_on)

// Disparo no gráfico: na primeira vela em que aparece a vela fechada nova
novaVela(int t) => not na(t) and t != t[1]
nv1 = novaVela(v1T)
nv4 = novaVela(v4T)
nvD = novaVela(dT)
nvR = novaVela(rT)
nvX = novaVela(xT)

avisar(int k, string nome, int dir, float ent, float stp, float alvo) =>
    desenharPlano(dir, ent, stp, alvo, nome)
    tp = na(alvo) ? "sem alvo fixo" : str.tostring(alvo, format.mintick)
    alert("Forex dude · " + nome + (dir == 1 ? " COMPRA " : " VENDA ") + syminfo.ticker + " ENT " + str.tostring(ent, format.mintick) + " SL " + str.tostring(stp, format.mintick) + " TP " + tp, alert.freq_once_per_bar_close)
    array.set(ultimo, k, quando(dir))

sVc = 0
sVv = 0
sCo = 0
sTe = 0
sTb = 0
sRo = 0
sDx = 0
if vcOn and vc1h and nv1 and v1C and acima200
    sVc := 1
    avisar(2, "VWAP 1H", 1, v1E, v1SC, v1E + 2 * (v1E - v1SC))
if vcOn and vc4h and nv4 and v4C and acima200
    sVc := 1
    avisar(2, "VWAP 4H", 1, v4E, v4SC, v4E + 2 * (v4E - v4SC))
if vvOn and vv1h and nv1 and v1V and abaixo200
    sVv := -1
    avisar(3, "VWAP 1H", -1, v1E, v1SV, v1E - 2 * (v1SV - v1E))
if vvOn and vv4h and nv4 and v4V and abaixo200
    sVv := -1
    avisar(3, "VWAP 4H", -1, v4E, v4SV, v4E - 2 * (v4SV - v4E))
if coOn and nvD and dCo
    sCo := 1
    avisar(4, "CONNORS", 1, dEnt, dStopC, dAlvoCo)
if teOn and nvD and dTe
    sTe := 1
    avisar(5, "TENDÊNCIA 55D", 1, dEnt, dStopC, na)
if tbOn and nvD and dTb
    sTb := -1
    avisar(6, "TENDÊNCIA BAIXA 55D", -1, dEnt, dStopV, na)
if roOn and nvR and rS
    sRo := 1
    avisar(7, "ROMPIMENTO 4H", 1, rE, rStop, rAlvo)
// O filtro da EMA 20 diária (até ontem) aplica-se aqui
if dxOn and nvX and xS != 0 and not na(ema20D) and (xS == 1 ? xE > ema20D : xE < ema20D)
    sDx := xS
    avisar(8, "DAX ABERTURA", xS, xE, xStop, na)

// ═══ Desenho e alertas ══════════════════════════════════════════════════════
bgcolor(asiaOn and naJanela ? color.new(color.yellow, 94) : na, title = "Janela de Londres (08–11)")
bgcolor(ictOn and kz and not naJanela ? color.new(color.gray, 94) : na, title = "Killzones ICT")
plotshape(sinalAsia == 1, "Asia compra", shape.triangleup, location.belowbar, corCompra, size = size.small)
plotshape(sinalAsia == -1, "Asia venda", shape.triangledown, location.abovebar, corVenda, size = size.small)
plotshape(sinalIct == 1, "ICT compra", shape.diamond, location.belowbar, corCompra, size = size.small)
plotshape(sinalIct == -1, "ICT venda", shape.diamond, location.abovebar, corVenda, size = size.small)
plotshape(sVc == 1, "VWAP compra", shape.circle, location.belowbar, corCompra, size = size.tiny)
plotshape(sVv == -1, "VWAP venda", shape.circle, location.abovebar, corVenda, size = size.tiny)
plotshape(sCo == 1, "Connors compra", shape.square, location.belowbar, corCompra, size = size.tiny)
plotshape(sTe == 1, "Tendência 55d compra", shape.arrowup, location.belowbar, corCompra, size = size.small)
plotshape(sTb == -1, "Tendência baixa venda", shape.arrowdown, location.abovebar, corVenda, size = size.small)
plotshape(sRo == 1, "Rompimento 4H compra", shape.flag, location.belowbar, corCompra, size = size.tiny)
plotshape(sDx == 1, "DAX compra", shape.xcross, location.belowbar, corCompra, size = size.tiny)
plotshape(sDx == -1, "DAX venda", shape.xcross, location.abovebar, corVenda, size = size.tiny)

alertcondition(sinalAsia == 1, "Asia Range · compra", "Forex dude: Asia Range COMPRA {{ticker}} @ {{close}}")
alertcondition(sinalAsia == -1, "Asia Range · venda", "Forex dude: Asia Range VENDA {{ticker}} @ {{close}}")
alertcondition(sinalIct == 1, "ICT ALGO · compra", "Forex dude: ICT ALGO COMPRA {{ticker}} @ {{close}}")
alertcondition(sinalIct == -1, "ICT ALGO · venda", "Forex dude: ICT ALGO VENDA {{ticker}} @ {{close}}")
alertcondition(sVc == 1, "VWAP · compra", "Forex dude: VWAP COMPRA {{ticker}} @ {{close}}")
alertcondition(sVv == -1, "VWAP · venda", "Forex dude: VWAP VENDA {{ticker}} @ {{close}}")
alertcondition(sCo == 1, "Connors RSI(2) · compra", "Forex dude: CONNORS COMPRA {{ticker}} @ {{close}}")
alertcondition(sTe == 1, "Tendência 55d · compra", "Forex dude: TENDÊNCIA 55D COMPRA {{ticker}} @ {{close}}")
alertcondition(sTb == -1, "Tendência baixa 55d · venda", "Forex dude: TENDÊNCIA BAIXA VENDA {{ticker}} @ {{close}}")
alertcondition(sRo == 1, "Rompimento 4H · compra", "Forex dude: ROMPIMENTO 4H COMPRA {{ticker}} @ {{close}}")
alertcondition(sDx == 1, "DAX abertura · compra", "Forex dude: DAX COMPRA {{ticker}} @ {{close}}")
alertcondition(sDx == -1, "DAX abertura · venda", "Forex dude: DAX VENDA {{ticker}} @ {{close}}")
alertcondition(sinalAsia != 0 or sinalIct != 0 or sVc != 0 or sVv != 0 or sCo != 0 or sTe != 0 or sTb != 0 or sRo != 0 or sDx != 0, "Qualquer estratégia", "Forex dude: sinal em {{ticker}} @ {{close}}")

// Painel: o estado de cada estratégia NESTE par e o último sinal
estado(bool usar, string pares) => not usar ? "desligada" : noPar(pares) ? "ligada" : "fora deste par"
corEstado(string e) => e == "ligada" ? corCompra : e == "desligada" ? color.gray : color.orange
linha(table tb, int r, string nome, string e, string ult) =>
    table.cell(tb, 0, r, nome, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, e, text_color = corEstado(e), text_size = size.small)
    table.cell(tb, 2, r, ult, text_color = color.white, text_size = size.small)

var table painel = table.new(position.top_right, 3, 14, bgcolor = color.new(color.black, 30), border_width = 1)
if barstate.islast
    table.cell(painel, 0, 0, "Forex dude", text_color = color.white, text_size = size.small)
    table.cell(painel, 1, 0, syminfo.ticker, text_color = color.white, text_size = size.small)
    table.cell(painel, 2, 0, "último sinal", text_color = color.silver, text_size = size.small)
    linha(painel, 1, "Asia Range", estado(usarAsia, paresAsia), array.get(ultimo, 0))
    linha(painel, 2, "ICT ALGO", estado(usarIct, paresIct), array.get(ultimo, 1))
    linha(painel, 3, "VWAP compra 1H/4H", estado(usarVc, paresVc), array.get(ultimo, 2))
    linha(painel, 4, "VWAP venda 1H/4H", estado(usarVv, paresVv), array.get(ultimo, 3))
    linha(painel, 5, "Connors RSI(2) 1D", estado(usarCo, paresCo), array.get(ultimo, 4))
    linha(painel, 6, "Tendência 55d 1D", estado(usarTe, paresTe), array.get(ultimo, 5))
    linha(painel, 7, "Tendência baixa 1D", estado(usarTb, paresTb), array.get(ultimo, 6))
    linha(painel, 8, "Rompimento 4H", estado(usarRo, paresRo), array.get(ultimo, 7))
    linha(painel, 9, "DAX abertura 30M", estado(usarDx, paresDx), array.get(ultimo, 8))
    table.cell(painel, 0, 10, "Viés 15M (Ásia)", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 10, vies15 == 1 ? "alta" : vies15 == -1 ? "baixa" : "—", text_color = vies15 == 1 ? corCompra : vies15 == -1 ? corVenda : color.silver, text_size = size.small)
    table.cell(painel, 0, 11, "Viés diário (ICT)", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 11, viesD == 1 ? "alta" : viesD == -1 ? "baixa" : "—", text_color = viesD == 1 ? corCompra : viesD == -1 ? corVenda : color.silver, text_size = size.small)
    table.cell(painel, 0, 12, "Setup ICT 1H", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(painel, 1, 12, iDir == 1 ? "compra à espera" : iDir == -1 ? "venda à espera" : "nenhum", text_color = color.white, text_size = size.small)
