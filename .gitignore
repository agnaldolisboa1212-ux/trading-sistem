node_modules/
dist/
.next/
# Builds antigos criavam uma LIGACAO .next na raiz (hoje apagada por
# scripts/limpar-next-na-raiz.mjs). `.next/` com barra so apanha pastas, e o git
# ve ligacoes como ficheiros — nunca pode chegar ao repositorio.
/.next
# Compilacao de producao do painel (distDir em apps/dashboard/next.config.mjs).
apps/dashboard/saida
# Nome antigo da mesma pasta, antes de passar a 'saida' — nunca vai para o repositorio.
apps/dashboard/compilado
# O que o build junta para a Output directory da Hostinger (scripts/preparar-saida.mjs).
/saida
# Trincos entre processos da aplicacao (server.js).
*.trinco
*.tsbuildinfo
.env
.env.local
.env.*.local
packages/data/scripts/public-apis.md
.DS_Store

# --- dados de execucao: gerados pelos motores e pelo painel, nunca versionados ---
# Sinais, estado dos motores e snapshots mudam a cada minuto e sao especificos
# de cada maquina. `.dados/` guarda as subscricoes push — endpoints de browsers
# de pessoas reais.
data/*.json
# Historico descarregado para o backtest (scripts/backtest/baixar.mjs)
data/backtest/
# Atencao: NAO usar `**/data/*.json`. Essa regra escondia tambem
# packages/data/package.json e packages/data/tsconfig.json — o pacote inteiro
# deixava de existir no GitHub e o deploy na Hostinger falhava.
apps/engine/data/
!data/.gitkeep
.dados/
apps/dashboard/.dados/

# --- ambiente e segredos (todas as variantes) ---
.env.*
!.env.example

# --- ruido ---
*.log
npm-debug.log*
.vercel/
supabase/.temp/
